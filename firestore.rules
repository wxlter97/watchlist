rules_version = '2';

// SPEC §6. Probadas con el emulador: pnpm test:rules
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Todo lo de un usuario (perfiles, progreso, planes, logros, dispositivos) es solo suyo.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Links públicos de solo lectura: guardan un snapshot, nunca el progreso vivo.
    // Un link activo se abre por su id; listar es solo del dueño (que también ve los
    // revocados, para reactivarlos): nadie puede enumerar los links de todos.
    match /shares/{shareId} {
      function owns() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      allow get: if resource.data.revoked == false || owns();
      allow list: if owns();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind in ['route', 'custom-order', 'progress']
        && request.resource.data.revoked == false;
      allow update: if owns() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owns();
    }

    match /groups/{groupId} {
      // memberUids (lista) duplica las claves de members para poder consultar
      // "mis grupos" con array-contains y probarlo en las reglas.
      function isMember(data) {
        return signedIn() && request.auth.uid in data.memberUids;
      }
      function consistent(data) {
        return data.members.keys().hasAll(data.memberUids)
          && data.memberUids.hasAll(data.members.keys())
          && data.memberNames.keys().hasOnly(data.members.keys());
      }

      allow read: if isMember(resource.data);

      // Se crea solo con uno mismo como dueño y único miembro.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && consistent(request.resource.data);

      // El dueño edita el grupo y puede sacar miembros, pero no agregar (eso pasa por
      // /api/groups/join, que valida inviteCode) ni ceder la propiedad. Un miembro solo
      // puede salirse; el dueño no se sale, borra el grupo. Marcar lo visto va en progress/.
      allow update: if isMember(resource.data)
        && consistent(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.members.keys().hasOnly(resource.data.members.keys())
        && (
          resource.data.ownerUid == request.auth.uid
            && resource.data.ownerUid in request.resource.data.memberUids
          || resource.data.ownerUid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids', 'memberNames'])
            && !(request.auth.uid in request.resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Cada miembro marca solo lo suyo en watchedBy; "lo vimos juntos" lo marca cualquiera.
      match /progress/{titleId} {
        function member() {
          return signedIn()
            && request.auth.uid in get(/databases/$(db)/documents/groups/$(groupId)).data.memberUids;
        }
        allow read: if member();
        allow create: if member()
          && request.resource.data.watchedBy.keys().hasOnly([request.auth.uid]);
        allow update: if member()
          && request.resource.data.watchedBy.diff(resource.data.watchedBy).affectedKeys().hasOnly([request.auth.uid]);
        // Al borrar el grupo, el dueño borra antes su progreso.
        allow delete: if signedIn()
          && get(/databases/$(db)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
      }
    }

    // Estado interno de los crons (proveedores ya avisados): solo firebase-admin.
    match /system/{document=**} {
      allow read, write: if false;
    }
  }
}
