# Solo servidor/scripts. Nunca con prefijo VITE_.
TMDB_API_KEY=
# JSON de una cuenta de servicio (feed de calendario). No hace falta con emuladores.
FIREBASE_SERVICE_ACCOUNT=
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" a los crons.
CRON_SECRET=

# Config web de Firebase (pública).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push: Consola de Firebase → Cloud Messaging → Certificados push web (par de claves).
VITE_FIREBASE_VAPID_KEY=
# Anuncios (opcional): ID de editor de AdSense (ca-pub-…). Sin él no se carga nada.
VITE_ADS_CLIENT=
VITE_ADS_SLOT_HUB=
