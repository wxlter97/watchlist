{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/upcoming.ts": {
      "includeFiles": "src/data/**"
    },
    "api/calendar.ts": {
      "includeFiles": "src/data/titles.json"
    },
    "api/og.ts": {
      "includeFiles": "{src/data/**,node_modules/.pnpm/harfbuzzjs@*/node_modules/harfbuzzjs/*.wasm}"
    },
    "api/share.ts": {
      "includeFiles": "src/data/**"
    },
    "api/cron/notify-releases.ts": {
      "includeFiles": "src/data/**"
    },
    "api/cron/notify-streaming.ts": {
      "includeFiles": "src/data/titles.json",
      "maxDuration": 60
    },
    "api/page.ts": {
      "includeFiles": "{src/data/**,src/locales/**}"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://watchlist-97b25.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/calendar/:file",
      "destination": "/api/calendar?file=:file"
    },
    {
      "source": "/:lang(es|en)/s/:id",
      "destination": "/api/share?lang=:lang&id=:id"
    },
    {
      "source": "/f/:id",
      "destination": "/api/page?type=f&id=:id"
    },
    {
      "source": "/t/:id",
      "destination": "/api/page?type=t&id=:id"
    },
    {
      "source": "/f/:id/r/:route",
      "destination": "/api/page?type=r&id=:id&route=:route"
    },
    {
      "source": "/en/f/:id/r/:route",
      "destination": "/api/page?type=r&id=:id&route=:route&lang=en"
    },
    {
      "source": "/faq",
      "destination": "/api/page?type=faq"
    },
    {
      "source": "/guide",
      "destination": "/api/page?type=guide"
    },
    {
      "source": "/en/faq",
      "destination": "/api/page?type=faq&lang=en"
    },
    {
      "source": "/en/guide",
      "destination": "/api/page?type=guide&lang=en"
    },
    {
      "source": "/en",
      "destination": "/api/page?type=home&lang=en"
    },
    {
      "source": "/en/f/:id",
      "destination": "/api/page?type=f&id=:id&lang=en"
    },
    {
      "source": "/en/t/:id",
      "destination": "/api/page?type=t&id=:id&lang=en"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?type=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/page?type=robots"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/page?type=llms"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/page?type=ads"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?type=privacy"
    },
    {
      "source": "/en/privacy",
      "destination": "/api/page?type=privacy&lang=en"
    },
    {
      "source": "/terms",
      "destination": "/api/page?type=terms"
    },
    {
      "source": "/en/terms",
      "destination": "/api/page?type=terms&lang=en"
    },
    {
      "source": "/about",
      "destination": "/api/page?type=about"
    },
    {
      "source": "/en/about",
      "destination": "/api/page?type=about&lang=en"
    },
    {
      "source": "/contact",
      "destination": "/api/page?type=contact"
    },
    {
      "source": "/en/contact",
      "destination": "/api/page?type=contact&lang=en"
    },
    {
      "source": "/developers",
      "destination": "/api/page?type=developers"
    },
    {
      "source": "/en/developers",
      "destination": "/api/page?type=developers&lang=en"
    },
    {
      "source": "/api/health",
      "destination": "/api/log"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/page?type=openapi"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/api/page?type=openapi"
    },
    {
      "source": "/api/franchises",
      "destination": "/api/page?type=api&resource=franchises"
    },
    {
      "source": "/api/franchises/:id",
      "destination": "/api/page?type=api&resource=franchises&id=:id"
    },
    {
      "source": "/api/titles/:id",
      "destination": "/api/page?type=api&resource=titles&id=:id"
    },
    {
      "source": "/:lang(en)?/:page(account|search|stats|map|achievements|compare|groups|join|wrapped|plans)/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(en)?/f/:id/:page(timeline)",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(en)?/f/:id/prep/:titleId",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path(.*)",
      "destination": "/api/page?type=api-404&path=:path"
    },
    {
      "source": "/:path(.*)",
      "destination": "/api/page?type=404&path=:path"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notify-releases",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/notify-streaming",
      "schedule": "30 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js|firebase-messaging-sw.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:lang(en)?/:page(account|plans|groups|join|compare|wrapped|stats|map|achievements|search)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\", </developers>; rel=\"service-doc\"; type=\"text/html\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://apis.google.com https://pagead2.googlesyndication.com https://www.googletagservices.com https://adservice.google.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://image.tmdb.org https://*.googleusercontent.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://pagead2.googlesyndication.com https://*.adtrafficquality.google https://*.doubleclick.net https://fundingchoicesmessages.google.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://*.safeframe.googlesyndication.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/log"
        }
      ]
    }
  ]
}
