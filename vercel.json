{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/upcoming.ts": {
      "includeFiles": "src/data/**"
    },
    "api/calendar.ts": {
      "includeFiles": "src/data/titles.json"
    },
    "api/og.ts": {
      "includeFiles": "{src/data/**,api/_fonts/**,node_modules/.pnpm/@resvg+resvg-js-linux-x64-*/**}"
    },
    "api/share.ts": {
      "includeFiles": "src/data/**"
    },
    "api/cron/notify-releases.ts": {
      "includeFiles": "src/data/**"
    },
    "api/cron/notify-streaming.ts": {
      "includeFiles": "src/data/titles.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://watchlist-97b25.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/calendar/:file",
      "destination": "/api/calendar?file=:file"
    },
    {
      "source": "/:lang(es|en)/s/:id",
      "destination": "/api/share?lang=:lang&id=:id"
    },
    {
      "source": "/((?!api/|assets/|__/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notify-releases",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/notify-streaming",
      "schedule": "30 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js|firebase-messaging-sw.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
